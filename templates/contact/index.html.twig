{% extends 'base.html.twig' %}

{% block title %}¡Hola! ¿Qué tal? - OpenGisCRM.com{% endblock %}

{% block meta %}
<meta name="description" content="contacto">
<meta name="keywords" content="contacto opengiscrm, contacto desarrollador web, contacto freelance"/>
{% endblock %}		

	{% block body %}
		{{ include('inc/navbar.html.twig') }}

		  <!-- Page Header-->
        <header class="masthead" style="background-image: url('assets/theme-blog/assets/img/contacto-bg.jpg')">
            <div class="container position-relative px-4 px-lg-5">
                <div class="row gx-4 gx-lg-5 justify-content-center">
                    <div class="col-md-10 col-lg-8 col-xl-7">
                        <div class="site-heading">
                            {# <h1>Contacto</h1>
                            <span class="subheading">Mensaje</span> #}
                        </div>
                    </div>
                </div>
            </div>
        </header> 
 

		<div class="container">

			<br>
	<br>

	<div class="row">

		<div class="col-12">
			<div class="text-center">

				<h1 class="texto-blog">¡Hola! ¿Qué tal? Cuéntame más de tu proyecto </h1>

				<p class="texto-blog">Contáctame completando el siguiente formulario, envíame un email directo a jonathancastro@opengiscrm.com, escucho tu idea.</p>

				<p class="texto-blog">¿Necesitas un desarrollador freelance, un programador remoto o adquirir un código de programación?.</p>				
				
				<hr>

			</div>
		</div>

		<div class="col-12">

			<br>

			<div class="text-center">

				<div class="text-info" id="msg_success">					
				</div>

				

				<div class="form-group">
					<div class="offset-md-3 col-sm-6">
						<input type="text" class="form-control" id="first_name" name="first_name" placeholder="Nombre">
						<div class="text-danger" id="msg_first_name">					
						</div>				
					</div>
				</div>

				<div class="form-group">
					<div class="offset-md-3 col-sm-6">
						<input type="text" class="form-control" id="last_name" name="last_name" placeholder="Apellido">
						<div class="text-danger" id="msg_last_name">					
						</div>				
					</div>
				</div>

				<div class="form-group">
					<div class="offset-md-3 col-sm-6">
						<input type="email" class="form-control" id="email" name="email" placeholder="Email">
						<div class="text-danger" id="msg_email">					
						</div>
					</div>
				</div>

				<div class="form-group">
					<div class="offset-md-3 col-sm-6">                              
						<textarea name="message" class="form-control" id="message" name="message" placeholder="Mensaje"></textarea>
						<div class="text-danger" id="msg_message">					
						</div>
					</div>
				</div>                         

				<div class="form-group">
					<div class="offset-md-3 col-sm-6">   
						<button type="submit" class="btn btn-primary btn-block">Enviar</button>
					</div>
				</div>                         


			

			</div> 

		</div> <!-- text -->


	</div> <!-- end row -->

	<br>
	<br>
	<br>
	<br>
	<br>
	<br>


		</div><!-- end container -->
		<br>
		<br>
		

		{{ include('inc/footer.html.twig') }} 
	{% endblock %}
