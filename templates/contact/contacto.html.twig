{% extends 'base.html.twig' %}

 {% block lang %}
<html lang="es">
 {% endblock %}

{% block title %}OpenGisCRM - Contacto{% endblock %}

{% block meta %}
<link rel="canonical" href="https://www.opengiscrm.com/contacto" />  	
<meta name="description" content="OpenGisCRM - Contacto, cuentame sobre tu proyecto online.">
<meta name="keywords" content="opengiscrm contact, web developer contact, freelance contact"/>
{% endblock %}	

{% block stylesheets %}
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css"
   integrity="sha512-xodZBNTC5n17Xt2atTPuE1HxjVMSvLVW9ocqUKLsCC5CXdbqCmblAshOMAS6/keqq/sMZMZ19scR4PsZChSR7A=="
   crossorigin=""/>

