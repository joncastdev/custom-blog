     // L.marker([10.48801, -66.87919],{draggable: true}).addTo(map);

     L.marker([40.6643, -73.9385],{draggable: true}).bindPopup("<b>OpenGisCRM</b><br>jonathancastro@opengiscrm.com").addTo(map).openPopup();

