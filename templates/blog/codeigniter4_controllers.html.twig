{% extends 'base.html.twig' %}

{% block title %}codeigniter 4 controllers{% endblock %}

	{% block meta %}
		<meta name="description" content="codeigniter 4 controllers">
		<meta name="keywords" content="codeigniter 4 controllers, codeigniter 4"/>
	{% endblock %}	

	{% block body %}
		{{ include('inc/navbar.html.twig') }}

		  <!-- Page Header-->
        <header class="masthead" style="background-image: url('../assets/theme-blog/assets/img/blog-bg.jpg')">
            <div class="container position-relative px-4 px-lg-5">
                <div class="row gx-4 gx-lg-5 justify-content-center">
                    <div class="col-md-10 col-lg-8 col-xl-7">
                        <div class="site-heading">
                            {# <h1>Blog</h1>
                            <span class="subheading">Encuentra Artículos</span> #}
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Post Content-->
        <article class="mb-4">
            <div class="container px-4 px-lg-5">
                <div class="row gx-4 gx-lg-5 justify-content-center">
                    <div class="col-md-10 col-lg-8 col-xl-7">

                    <img class="img-fluid" src="../assets/img/ci4_controllers.png" alt="ci4_controllers">

                        <p>En este artículo veremos como utilizar los controladores en la versión 4 de codeigniter framework.</p>
                        <p>Primero tenemos la estructura básica de un controlador.</p>          
                        <h2 class="section-heading">Controlador Básico</h2>
				        <pre class="text-code">
						<code class="">
		class Users extends BaseController
		{
		public function index()
		{		
		
		$data['tittle'] = 'Users';		

		return view('admin/index',$data);
		}

		}

						</code>
						</pre>
						<p>Los controladores se encuentran hubicados en <code>app/Controllers</code>, todo controlador extiende del controlador principal llamado BaseController, el cual se encuentra en la misma ruta.</p>
						<p>
						<code class="">

						class Users extends BaseController

						</code>
						</p>
						<p>Aqui tenemos el BaseController el cual extiende de Controller que es la clase core del framework, atraves de la función initController podemos cargar automaticamente servicios,libreria,modelos etc.</p>
						<p>
						<pre class="text-code">
		<code class="">
		namespace App\Controllers;

		/**
		* Class BaseController
		*
		* BaseController provides a convenient place for loading components
		* and performing functions that are needed by all your controllers.
		* Extend this class in any new controllers:
		*     class Home extends BaseController
		*
		* For security be sure to declare any new methods as protected or private.
		*
		* @package CodeIgniter
		*/

		use CodeIgniter\Controller;

		class BaseController extends Controller
		{

		/**
		* An array of helpers to be loaded automatically upon
		* class instantiation. These helpers will be available
		* to all other controllers that extend BaseController.
		*
		* @var array
		*/
		protected $helpers = [];

		/**
		* Constructor.
		*/
		public function initController(\CodeIgniter\HTTP\RequestInterface $request, \CodeIgniter\HTTP\ResponseInterface $response, \Psr\Log\LoggerInterface $logger)
		{
		// Do Not Edit This Line
		parent::initController($request, $response, $logger);

		//--------------------------------------------------------------------
		// Preload any models, libraries, etc, here.
		//--------------------------------------------------------------------
		// E.g.:
		// $this->session = \Config\Services::session();
		}

		}

		</code>
		</pre>	
						</p>
						<p>En su interior tenemos una variable <code>$data</code> la cual se la podemos pasar a una vista.</p>
						<p>
						<code class="">

						public function index()

						</code>	
						</p>
						<p>Ahora tenemos el metodo index, el cual es el primer metodo que se ejecuta al cargar la clase, al menos que carguemos el constructor.</p>
						<p>
						<code class="">

						$data['tittle'] = 'Users';	

						</code>	
						</p>
						<p>Finalmente retornamos una vista, donde el primer parametro es el path de la vista y la cual acepta como segundo parametro la <code>$data</code>.</p>
						<p>
						<code class="">

						return view('admin/index',$data);	

						</code>	
						</p>
						<p><strong>En este video se muestra el funcionamiento de los controladores.</strong></p>
						<p>
						<iframe width="560" height="315" src="https://www.youtube.com/embed/obMDQXiEpLQ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>	
						</p>
						<blockquote class="blockquote">jonathancastro@opengiscrm.com</blockquote> 
						<p>
						<a class="btn btn-outline-primary" href="/blog">
						<span class="fas fa-arrow-left"></span>		
						Regresar</a>

						</p>                             
                    </div>
                </div>
            </div>
        </article>   		



		{{ include('inc/footer.html.twig') }} 
	{% endblock %}
