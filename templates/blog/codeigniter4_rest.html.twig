		<p>En este artículo veremos como crear una <strong>API REST en CodeIgniter 4</strong>,con el uso del <strong>API Response Trait</strong>, algo nuevo que se incorpora en esta nueva versión, también aprenderemos como usar las rutas y el uso de rutas de tipo <strong>resource</strong>.</p>

		<h2>¿Como crear una RestFul api codeigniter 4?</h2>

		{{ include('inc/ad_defect.html.twig') }} 	
		
		<p>Primero partiremos desde nuestro controlador, esto se encuentra en <code>nombreApp/app/Controller/Users.php</code>, nosotros vamos a realizar una <strong>api rest de tipo crud</strong> para realizar operaciones con usuarios.</p>

		<pre class="text-code">
		<code>
		// importamos el trait	
		use CodeIgniter\API\ResponseTrait;

		// importamos el modelo
		use App\Models\UserModel;

		class Users extends BaseController
		{
			// usamos el trait
			use ResponseTrait;

			// declaramos las variables
			protected $UserModel;			

			protected $validation;	


			public function __construct()
			{

				$this->UserModel = new UserModel();

				// cargamos el helper form
				helper('form');				

				// cargamos el servicio de validación
				$this->validation =  \Config\Services::validation();

			}

			public function index()
			{		

				// lista de metódos que nos trae el trait
				// Generic response method
				// 		respond($data, 200);
				// // Generic failure response
				// 		fail($errors, 400);
				// // Item created response
				// 		respondCreated($data);
				// // Item successfully deleted
				// 		respondDeleted($data);
				// // Command executed by no response required
				// 		respondNoContent($message);
				// // Client isn't authorized
				// 		failUnauthorized($description);
				// // Forbidden action
				// 		failForbidden($description);
				// // Resource Not Found
				// 		failNotFound($description);
				// // Data did not validate
				// 		failValidationError($description);
				// // Resource already exists
				// 		failResourceExists($description);
				// // Resource previously deleted
				// 		failResourceGone($description);
				// // Client made too many requests
				// 		failTooManyRequests($description);
				
				// consulta, vendria a ser select * from users;
				$data['users'] = $this->UserModel->findAll();			

				// le pasamos la data, y obtenemos un status code 200
				return $this->respond($data);			
				
				
			}


			public function create()
			{
				// declaramos reglas de validación desde el front-end
				$rules = [
					'first_name' => [
						'rules'  => 'required',
						'errors' => [
							'required' => 'Nombre es requerido.'
						]
					],
					'last_name' => [
						'rules'  => 'required',
						'errors' => [
							'required' => 'Apellido es requerido.'
						]
					],
					'password' => [
						'rules'  => 'required',
						'errors' => [
							'required' => 'Password es requerido.'
						]
					],
					'email'    => [
						'rules'  => 'required|valid_email',
						'errors' => [
							'required' => 'Email es requerido.',
							'valid_email' => 'Verifica el email.'
						]
					],
				];		

				// obtenemos todo lo que enviamos por el metódo post
				$data = $this->request->getPost();

				

				// si falla la validación
				if (!$this->validate($rules)) {

					$errors = $this->validator->listErrors();			

					return $this->failValidationError($errors);					
					
				}else{

					// consulta para crear un recurso, insert into users etc
					$data = $this->UserModel->save($data);

					// metodo al crear un recurso status code 201
					return $this->respondCreated($data);
				}		
				
			}


			public function show($id)
			{
				

				if (!$data = $this->UserModel->find($id)) {			

					
					// usamos una excepcion predeterminada del framework, para status code 404
					throw \CodeIgniter\Exceptions\PageNotFoundException::forPageNotFound("Un error a ocurrido");
					

				}else{

					// status code 200
					return $this->respond($data);
				}
				
				
			}

			public function update($id)
			{
				
				// obtenemos todo lo que enviamos por metodos puto o patch
				$data = $this->request->getRawInput();
				

				if (!$user = $this->UserModel->find($id)) {

					// metodo cuando no encontramos un recurso
					return $this->failNotFound('Usuario con  id nro:'.$id.' no encontrado.');
					
				}else{

					// update users etc
					$data['user'] = $this->UserModel->update($id,$data);

					return $this->respond($data);


				}

				
				
			}


			public function delete($id)
			{		

				
				// validamos que eliminamos un usuario por el ide, delete users etc
				if ($data = $this->UserModel->delete($id)) {			

					// respuesta al eliminar
					return $this->respondDeleted();
					
				}
				
				
			}

			

		}
